<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="course">

    <!-- Basic scene -->
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- GPS origin (datum). The robot spawns at the world origin, so this
         lat/lon corresponds to map (0,0). It must match navsat_transform
         'datum' in dual_ekf_navsat.yaml.
         heading_deg=180 works around the Gazebo Classic ENU sign bug so the
         GPS sensor outputs correct East/North/Up. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>55.7558</latitude_deg>
      <longitude_deg>37.6173</longitude_deg>
      <elevation>150.0</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ========================= START ZONE A (green) ================= -->
    <model name="start_zone">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.0 1.0 0.01</size></box></geometry>
          <material>
            <ambient>0.1 0.8 0.1 0.6</ambient>
            <diffuse>0.1 0.8 0.1 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================= FINISH ZONE B (red) ================= -->
    <model name="finish_zone">
      <static>true</static>
      <pose>8 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.0 1.0 0.01</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 0.6</ambient>
            <diffuse>0.8 0.1 0.1 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================= Static obstacles ==================== -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>2.0 0.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>3.3 -1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.4 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_3">
      <static>true</static>
      <pose>5.0 0.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_4">
      <static>true</static>
      <pose>6.3 -0.7 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.4 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
